---
import strings_zh from '../i18n/zh.json';
import strings_en from '../i18n/en.json';

interface Props {
  src: string; // local /media/*.mp4 path, or an external embed URL (YouTube/Vimeo)
  poster?: string;
  lang: 'zh-Hant' | 'en';
}

const { src, poster, lang } = Astro.props;
const t = lang === 'en' ? strings_en : strings_zh;
const isExternal = /youtube\.com|youtu\.be|vimeo\.com/.test(src);

function toEmbedUrl(url: string) {
  const yt = url.match(/(?:youtu\.be\/|youtube\.com\/watch\?v=)([\w-]+)/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vimeo = url.match(/vimeo\.com\/(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return url;
}
---

<section class="work-media">
  <h2 class="font-mono-label mb-3" style="color:var(--ink-mid)">{t.work.video}</h2>
  {isExternal ? (
    <div class="aspect-video w-full">
      <iframe
        src={toEmbedUrl(src)}
        class="h-full w-full"
        loading="lazy"
        title={t.work.video}
        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      ></iframe>
    </div>
  ) : (
    <video controls playsinline preload="none" poster={poster} class="w-full">
      <source src={src} type="video/mp4" />
    </video>
  )}
</section>
