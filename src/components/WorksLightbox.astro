---
import strings_zh from '../i18n/zh.json';
import strings_en from '../i18n/en.json';

interface Props {
  lang: 'zh-Hant' | 'en';
}

const { lang } = Astro.props;
const t = lang === 'en' ? strings_en : strings_zh;
const prefix = lang === 'en' ? '/en' : '';
---

<div data-works-lightbox hidden class="fixed inset-0 z-50 flex flex-col bg-black/95 p-4 md:p-8">
  <div class="flex items-center justify-between gap-4">
    <div class="font-mono-label text-white/80">
      <span data-lightbox-title></span>
      <a data-lightbox-fulllink href="#" class="ml-3 underline hover:[color:var(--accent)]">
        {t.work.viewFull}
      </a>
    </div>
    <button type="button" data-lightbox-close aria-label={t.lightbox.close} class="text-white/80 hover:text-white">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none"><path d="M5 5L19 19M19 5L5 19" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </div>

  <div class="relative flex flex-1 items-center justify-center overflow-hidden">
    <button type="button" data-lightbox-prev aria-label={t.lightbox.prev} class="absolute left-0 z-10 p-2 text-white/60 hover:text-white md:left-2">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
    <img data-lightbox-main src="" alt="" class="max-h-full max-w-full object-contain" draggable="false" />
    <div data-lightbox-video hidden class="aspect-video max-h-full w-full max-w-4xl"></div>
    <div
      data-lightbox-sound-hint
      hidden
      class="absolute right-4 top-4 z-20 cursor-pointer whitespace-nowrap rounded-full bg-black/70 px-4 py-2 text-sm text-white/90 backdrop-blur-sm transition-opacity duration-500"
    >
      🔇 {t.lightbox.soundHint}
    </div>
    <button type="button" data-lightbox-next aria-label={t.lightbox.next} class="absolute right-0 z-10 p-2 text-white/60 hover:text-white md:right-2">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 5L16 12L9 19" stroke="currentColor" stroke-width="1.5" /></svg>
    </button>
  </div>

  <div data-lightbox-thumbs class="mt-4 flex justify-center gap-2 overflow-x-auto pb-1"></div>
</div>

<script define:vars={{ prefix }}>
  (function () {
    const overlay = document.querySelector('[data-works-lightbox]');
    if (!overlay) return;

    const mainImg = overlay.querySelector('[data-lightbox-main]');
    const videoWrap = overlay.querySelector('[data-lightbox-video]');
    const soundHint = overlay.querySelector('[data-lightbox-sound-hint]');
    const thumbsEl = overlay.querySelector('[data-lightbox-thumbs]');
    const titleEl = overlay.querySelector('[data-lightbox-title]');
    const fullLink = overlay.querySelector('[data-lightbox-fulllink]');
    const closeBtn = overlay.querySelector('[data-lightbox-close]');
    const prevBtn = overlay.querySelector('[data-lightbox-prev]');
    const nextBtn = overlay.querySelector('[data-lightbox-next]');

    const cache = new Map();
    let current = null; // { id, images, video, index } — slide 0 is the video when present, images follow after

    const SOUND_HINT_KEY = 'hikari-video-sound-hint-seen';
    let hintTimer;

    function hasSeenSoundHint(id) {
      try {
        return JSON.parse(sessionStorage.getItem(SOUND_HINT_KEY) || '[]').includes(id);
      } catch {
        return false;
      }
    }

    function markSoundHintSeen(id) {
      try {
        const seen = JSON.parse(sessionStorage.getItem(SOUND_HINT_KEY) || '[]');
        if (!seen.includes(id)) sessionStorage.setItem(SOUND_HINT_KEY, JSON.stringify([...seen, id]));
      } catch {}
    }

    function hideSoundHint() {
      clearTimeout(hintTimer);
      soundHint.style.opacity = '0';
      soundHint.hidden = true;
      soundHint.onclick = null;
    }

    // Shown the first time each individual work's video plays this browsing
    // session — muted autoplay otherwise gives no clue that sound is available.
    function maybeShowSoundHint(videoEl, id) {
      if (hasSeenSoundHint(id)) return;
      markSoundHintSeen(id);
      soundHint.hidden = false;
      soundHint.style.opacity = '1';
      soundHint.onclick = () => {
        if (videoEl) videoEl.muted = false; // local video: hint doubles as an unmute button
        hideSoundHint();
      };
      hintTimer = setTimeout(hideSoundHint, 5000);
    }

    function slideCount() {
      return (current.video ? 1 : 0) + current.images.length;
    }

    function renderThumbs() {
      thumbsEl.innerHTML = '';
      if (!current || slideCount() < 2) return;

      if (current.video) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'relative h-14 w-20 shrink-0 overflow-hidden border-2';
        btn.style.borderColor = current.index === 0 ? 'var(--accent)' : 'transparent';
        btn.setAttribute('aria-label', 'video');
        const thumbImg = document.createElement('img');
        thumbImg.src = current.video.poster;
        thumbImg.alt = '';
        thumbImg.className = 'h-full w-full object-cover';
        thumbImg.draggable = false;
        btn.appendChild(thumbImg);
        const playIcon = document.createElement('span');
        playIcon.className = 'absolute inset-0 flex items-center justify-center text-white';
        playIcon.innerHTML = '<svg width="16" height="16" viewBox="0 0 8 8" fill="currentColor"><path d="M1 0.5L7.5 4 1 7.5V0.5Z" /></svg>';
        btn.appendChild(playIcon);
        btn.addEventListener('click', () => show(0));
        thumbsEl.appendChild(btn);
      }

      const offset = current.video ? 1 : 0;
      current.images.forEach((img, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'h-14 w-20 shrink-0 overflow-hidden border-2';
        btn.style.borderColor = i + offset === current.index ? 'var(--accent)' : 'transparent';
        btn.setAttribute('aria-label', `${i + 1}`);
        const thumbImg = document.createElement('img');
        thumbImg.src = img.thumb;
        thumbImg.alt = '';
        thumbImg.className = 'h-full w-full object-cover';
        thumbImg.draggable = false;
        btn.appendChild(thumbImg);
        btn.addEventListener('click', () => show(i + offset));
        thumbsEl.appendChild(btn);
      });
    }

    function show(index) {
      if (!current) return;
      current.index = (index + slideCount()) % slideCount();
      const isVideoSlide = current.video && current.index === 0;

      if (isVideoSlide) {
        mainImg.hidden = true;
        mainImg.src = '';
        videoWrap.hidden = false;
        videoWrap.innerHTML = '';
        if (current.video.type === 'local') {
          const v = document.createElement('video');
          v.src = current.video.src;
          v.controls = true;
          v.playsInline = true;
          v.autoplay = true;
          v.muted = true; // browsers block unmuted autoplay
          v.poster = current.video.poster;
          v.className = 'h-full w-full';
          videoWrap.appendChild(v);
          maybeShowSoundHint(v, current.id);
        } else {
          const muteParam = current.video.src.includes('vimeo.com') ? 'muted' : 'mute';
          const iframe = document.createElement('iframe');
          iframe.src = current.video.src + `?autoplay=1&${muteParam}=1`;
          iframe.className = 'h-full w-full';
          iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
          iframe.allowFullscreen = true;
          videoWrap.appendChild(iframe);
          maybeShowSoundHint(null, current.id);
        }
      } else {
        videoWrap.hidden = true;
        videoWrap.innerHTML = '';
        mainImg.hidden = false;
        const imgIndex = current.video ? current.index - 1 : current.index;
        mainImg.src = current.images[imgIndex].full;
        hideSoundHint();
      }
      renderThumbs();
    }

    function close() {
      overlay.hidden = true;
      document.body.style.overflow = '';
      videoWrap.innerHTML = '';
      hideSoundHint();
      current = null;
    }

    async function open(id, lang) {
      document.body.style.overflow = 'hidden';
      overlay.hidden = false;
      titleEl.textContent = '…';
      mainImg.src = '';
      videoWrap.hidden = true;
      videoWrap.innerHTML = '';
      thumbsEl.innerHTML = '';

      let data = cache.get(id);
      if (!data) {
        try {
          const res = await fetch(`/works-data/${id}.json`);
          data = await res.json();
          cache.set(id, data);
        } catch {
          close();
          return;
        }
      }

      titleEl.textContent = lang === 'en' ? data.titleEn : data.title;
      fullLink.href = `${prefix}/works/${data.id}`;
      current = { id, images: data.images, video: data.video, index: 0 };
      show(0);
    }

    document.querySelectorAll('[data-open-work]').forEach((card) => {
      card.addEventListener('click', () => {
        const id = card.getAttribute('data-open-work');
        const lang = card.getAttribute('data-open-work-lang') || 'zh-Hant';
        open(id, lang);
      });
    });

    closeBtn?.addEventListener('click', close);
    prevBtn?.addEventListener('click', () => current && show(current.index - 1));
    nextBtn?.addEventListener('click', () => current && show(current.index + 1));

    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    document.addEventListener('keydown', (e) => {
      if (overlay.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') current && show(current.index - 1);
      if (e.key === 'ArrowRight') current && show(current.index + 1);
    });

    let touchStartX = 0;
    overlay.addEventListener('touchstart', (e) => (touchStartX = e.changedTouches[0].clientX), { passive: true });
    overlay.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - touchStartX;
        if (current && Math.abs(dx) > 40) show(current.index + (dx < 0 ? 1 : -1));
      },
      { passive: true }
    );
  })();
</script>
