---
import strings_zh from '../i18n/zh.json';
import strings_en from '../i18n/en.json';
import { site } from '../config/site';

interface Props {
  lang: 'zh-Hant' | 'en';
  path: string;
}

const { lang, path } = Astro.props;
const t = lang === 'en' ? strings_en : strings_zh;
const prefix = lang === 'en' ? '/en' : '';
const links = [
  { href: '/works', label: t.nav.works },
  { href: '/about', label: t.nav.about },
  { href: '/faq', label: t.nav.faq },
];

const otherLangHref = (lang === 'en' ? path : `/en${path}`) || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="sticky top-0 z-40 border-b bg-[var(--paper)]/95 backdrop-blur-sm" style="border-color:var(--hairline)">
  <div class="mx-auto flex max-w-[1440px] items-center justify-between gap-6 px-5 py-4 md:px-10">
    <a href={`${prefix}/`} class="flex shrink-0 items-baseline gap-2" style="font-family:var(--font-display)">
      <span class="text-xl font-bold tracking-tight sm:text-2xl">{site.nameEn}</span>
      <span class="hidden text-sm sm:inline" style="color:var(--ink-mid)">{site.shortName}</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a
          href={`${prefix}${l.href}`}
          class:list={[
            'font-mono-label border-b-2 pb-1',
            isActive(l.href) ? 'font-semibold border-[var(--accent)] [color:var(--accent)]' : 'border-transparent hover:[color:var(--accent)]',
          ]}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={`${prefix}/about#contact`}
        class="font-mono-label hidden shrink-0 px-4 py-2 sm:inline-block"
        style={`border-radius:var(--radius-btn); background:var(--accent); color:var(--ink)`}
      >
        {t.nav.cta}
      </a>
      <a href={otherLangHref} data-lang-switch aria-label={t.lang.switch} class="grid h-8 w-8 shrink-0 place-items-center hover:[color:var(--accent)]">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="9" cy="9" r="7.5" stroke="currentColor" />
          <path d="M1.5 9h15M9 1.5c2.2 2 3.5 4.7 3.5 7.5s-1.3 5.5-3.5 7.5c-2.2-2-3.5-4.7-3.5-7.5S6.8 3.5 9 1.5Z" stroke="currentColor" />
        </svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        aria-label={t.theme.toggle}
        class="grid h-8 w-8 shrink-0 place-items-center"
      >
        <svg data-icon="sun" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8" cy="8" r="3.5" stroke="currentColor" />
          <path d="M8 0.5V2.5M8 13.5V15.5M15.5 8H13.5M2.5 8H0.5M13.3 2.7L11.9 4.1M4.1 11.9L2.7 13.3M13.3 13.3L11.9 11.9M4.1 4.1L2.7 2.7" stroke="currentColor" stroke-linecap="round" />
        </svg>
        <svg data-icon="moon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:none">
          <path d="M14 9.3A6 6 0 116.7 2a4.7 4.7 0 007.3 7.3z" stroke="currentColor" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <nav class="flex items-center gap-4 overflow-x-auto border-t px-5 py-2 md:hidden" style="border-color:var(--hairline)">
    {links.map((l) => (
      <a
        href={`${prefix}${l.href}`}
        class:list={[
          'font-mono-label whitespace-nowrap border-b-2 pb-1',
          isActive(l.href) ? 'font-semibold border-[var(--accent)] [color:var(--accent)]' : 'border-transparent hover:[color:var(--accent)]',
        ]}
      >
        {l.label}
      </a>
    ))}
  </nav>
</header>

<script is:inline>
  (function () {
    // preserve query string (e.g. /works filter state) when switching language
    var a = document.querySelector('[data-lang-switch]');
    if (a && location.search) a.setAttribute('href', a.getAttribute('href') + location.search);

    var btn = document.getElementById('theme-toggle');
    if (!btn) return;
    var sun = btn.querySelector('[data-icon="sun"]');
    var moon = btn.querySelector('[data-icon="moon"]');

    function sync() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      sun.style.display = isDark ? 'none' : 'block';
      moon.style.display = isDark ? 'block' : 'none';
    }
    sync();

    btn.addEventListener('click', function () {
      var next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      sync();
    });
  })();
</script>
