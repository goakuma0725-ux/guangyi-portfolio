---
import BaseLayout from '../../layouts/BaseLayout.astro';
import strings_en from '../../i18n/en.json';
import { site, telHref } from '../../config/site';

const t = strings_en;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.addressEn)}`;

const brands: { name: string; logo: string }[] = [];

const tools = [
  {
    label: '3DS MAX & V-RAY',
    desc: 'High-fidelity rendering and complex material simulation.',
    icon: 'M12 3l8 4.5v9L12 21l-8-4.5v-9L12 3Zm0 0v18M4 7.5l8 4.5 8-4.5',
  },
  {
    label: 'UNREAL ENGINE',
    desc: 'Real-time architectural walkthroughs and interactive simulation.',
    icon: 'M2 12c2.5-4.5 6-6.8 10-6.8s7.5 2.3 10 6.8c-2.5 4.5-6 6.8-10 6.8S4.5 16.5 2 12Zm10 3a3 3 0 100-6 3 3 0 000 6Z',
  },
  {
    label: 'CAD & BIM',
    desc: 'Seamless integration with engineering data and drawings.',
    icon: 'M3 3h18v18H3V3Zm0 6h18M3 15h18M9 3v18M15 3v18',
  },
  {
    label: 'SKETCHUP',
    desc: 'Fast massing studies and concept visualization.',
    icon: 'M4 18l5-11 5 7 3-4 3 8H4Z M5 19a1 1 0 100-2 1 1 0 000 2Zm14 0a1 1 0 100-2 1 1 0 000 2Zm-5-11a1 1 0 100-2 1 1 0 000 2Z',
  },
];
---

<BaseLayout lang="en" path="/about" title={`${t.about.title} | ${site.nameEn}`} description={site.introEn}>
  <div class="mx-auto max-w-[1600px] px-5 py-8 md:px-10">
    <h1 style="font-size:32px">{t.about.title}</h1>
    <p class="mt-6 max-w-[70ch]" style="font-size:18px">{site.introEn}</p>

    <div class="mt-10">
      <p class="font-mono-label" style="color:var(--ink-mid)">{t.about.toolsTitle}</p>
      <div class="mt-3 grid gap-3 sm:grid-cols-2">
        {tools.map((tool) => (
          <div class="border p-4" style="border-color:var(--hairline)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" style="color:var(--accent)" aria-hidden="true">
              <path d={tool.icon} stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" stroke-linecap="round" />
            </svg>
            <p class="font-mono-label mt-2" style="color:var(--accent)">{tool.label}</p>
            <p class="mt-1 text-sm" style="color:var(--ink-mid)">{tool.desc}</p>
          </div>
        ))}
      </div>
    </div>

    {brands.length > 0 && (
      <div class="mt-14">
        <p class="font-mono-label mb-4" style="color:var(--ink-mid)">{t.about.brandsTitle}</p>
        <div class="grid grid-cols-3 gap-6 sm:grid-cols-4 md:grid-cols-6">
          {brands.map((b) => (
            <img src={b.logo} alt={b.name} class="h-10 w-auto grayscale transition hover:grayscale-0" />
          ))}
        </div>
      </div>
    )}

    <div id="contact" class="mt-16 scroll-mt-24 border-t pt-10" style="border-color:var(--hairline)">
      <h2 style="font-size:24px">{t.contact.title}</h2>

      <div class="mt-8 grid gap-8 md:grid-cols-[2fr_1fr]">
        <div class="divide-y" style="border-top:1px solid var(--hairline); border-bottom:1px solid var(--hairline)">
          {site.lineId && (
            <div class="flex items-center justify-between gap-4 py-5">
              <div class="flex items-center gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:var(--ink-mid)" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 01-8.9 8.4 9.3 9.3 0 01-3-.5L4 20.5l1.4-4.2A8.3 8.3 0 013 11.5 8.4 8.4 0 0111.9 3.1 8.5 8.5 0 0121 11.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                <div>
                  <p class="font-mono-label" style="color:var(--ink-mid)">{t.contact.line}</p>
                  <p style="font-size:18px">{site.lineId}</p>
                </div>
              </div>
              <a href={site.lineUrl} target="_blank" rel="noopener" class="font-mono-label border px-4 py-2 hover:[color:var(--accent)]" style="border-color:var(--hairline)">
                {t.contact.addFriend}
              </a>
            </div>
          )}

          {site.mobile && (
            <div class="flex items-center justify-between gap-4 py-5">
              <div class="flex items-center gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:var(--ink-mid)" aria-hidden="true"><rect x="7" y="2" width="10" height="20" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M10.5 18.5h3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" /></svg>
                <div>
                  <p class="font-mono-label" style="color:var(--ink-mid)">{t.contact.mobile}</p>
                  <p style="font-size:18px">{site.mobile}</p>
                </div>
              </div>
              <a href={telHref(site.mobile)} class="font-mono-label border px-4 py-2 hover:[color:var(--accent)]" style="border-color:var(--hairline)">
                {t.contact.call}
              </a>
            </div>
          )}

          {site.phone && (
            <div class="flex items-center justify-between gap-4 py-5">
              <div class="flex items-center gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:var(--ink-mid)" aria-hidden="true"><path d="M5 4h3.5l1.5 4-2 1.5a12 12 0 006 6l1.5-2 4 1.5V19a2 2 0 01-2 2C10.5 21 3 13.5 3 6a2 2 0 012-2Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                <div>
                  <p class="font-mono-label" style="color:var(--ink-mid)">{t.contact.phone}</p>
                  <p style="font-size:18px">{site.phone}</p>
                </div>
              </div>
              <a href={telHref(site.phone)} class="font-mono-label border px-4 py-2 hover:[color:var(--accent)]" style="border-color:var(--hairline)">
                {t.contact.call}
              </a>
            </div>
          )}

          {site.email && (
            <div class="flex items-center justify-between gap-4 py-5">
              <div class="flex items-center gap-3">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" style="color:var(--ink-mid)" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M3.5 6l8.5 7 8.5-7" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" /></svg>
                <div>
                  <p class="font-mono-label" style="color:var(--ink-mid)">{t.contact.email}</p>
                  <p style="font-size:18px">{site.email}</p>
                </div>
              </div>
              <button type="button" data-copy={site.email} class="font-mono-label border px-4 py-2 hover:[color:var(--accent)]" style="border-color:var(--hairline)">
                {t.contact.copy}
              </button>
            </div>
          )}

          {site.addressEn && (
            <div class="py-5">
              <p class="font-mono-label" style="color:var(--ink-mid)">{t.about.officeTitle}</p>
              <p style="font-size:18px">{site.addressEn}</p>
              <a href={mapsUrl} target="_blank" rel="noopener" class="font-mono-label mt-2 inline-block underline hover:[color:var(--accent)]">
                {t.contact.mapLink}
              </a>
            </div>
          )}
        </div>

        {site.lineUrl && (
          <div class="flex flex-col items-center gap-2 self-start border p-6" style="border-color:var(--hairline)">
            <img src="/line-qr.png" width="200" height="200" alt={`LINE QR ${site.lineId}`} loading="lazy" />
            <p class="font-mono-label" style="color:var(--ink-mid)">{site.lineId}</p>
          </div>
        )}
      </div>
    </div>
  </div>

  <script define:vars={{ copiedLabel: t.contact.copied }}>
    document.querySelectorAll('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(btn.getAttribute('data-copy'));
        const original = btn.textContent;
        btn.textContent = copiedLabel;
        setTimeout(() => (btn.textContent = original), 1500);
      });
    });
  </script>
</BaseLayout>
