---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GalleryLightbox from '../../components/GalleryLightbox.astro';
import VideoBlock from '../../components/VideoBlock.astro';
import strings_zh from '../../i18n/zh.json';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
const t = strings_zh;
const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
const idx = allWorks.findIndex((w) => w.id === work.id);
const prev = allWorks[(idx - 1 + allWorks.length) % allWorks.length];
const next = allWorks[(idx + 1) % allWorks.length];

const title = work.data.title;
const domainLabel = work.data.domain.join(' · ');
const serviceLabel = work.data.service.join(' · ');
const description = `${title}｜${domainLabel}｜${site.name}`;
---

<BaseLayout lang="zh-Hant" path={`/works/${work.id}`} title={`${title} ｜ ${site.name}`} description={description} ogImage={work.data.cover.src}>
  <article class="px-5 py-8 md:px-10">
    <a href="/works" class="font-mono-label" style="color:var(--ink-mid)">&larr; {t.work.backToWorks}</a>

    <h1 class="mt-4" style="font-size:32px">{title}</h1>
    <p class="font-mono-label mt-2" style="color:var(--ink-mid)">
      {domainLabel} · {serviceLabel}{work.data.year ? ` · ${work.data.year}` : ''}
    </p>

    <div class="work-media mt-6 aspect-[16/9] overflow-hidden border" style="border-color:var(--hairline)">
      <Image src={work.data.cover} alt={`${title} ${domainLabel}`} width={1920} height={1080} loading="eager" fetchpriority="high" draggable="false" class="h-full w-full object-cover" />
    </div>

    {work.data.gallery && work.data.gallery.length > 0 && (
      <div class="mt-6">
        <GalleryLightbox images={work.data.gallery} altBase={title} />
      </div>
    )}

    {work.data.video && (
      <div class="mt-6">
        <VideoBlock src={work.data.video.src} poster={work.data.video.poster} lang="zh-Hant" />
      </div>
    )}

    <nav class="mt-10 flex items-center justify-between border-t pt-4" style="border-color:var(--hairline)">
      <a href={`/works/${prev.id}`} class="font-mono-label">&larr; {t.work.prev}</a>
      <a href={`/works/${next.id}`} class="font-mono-label">{t.work.next} &rarr;</a>
    </nav>
  </article>
</BaseLayout>
