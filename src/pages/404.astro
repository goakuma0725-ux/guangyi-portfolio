---
import BaseLayout from '../layouts/BaseLayout.astro';
import strings_zh from '../i18n/zh.json';
import { site } from '../config/site';

const t = strings_zh;
---

<BaseLayout lang="zh-Hant" path="/404" title={`${t.notFound.title} ｜ ${site.name}`} description={t.notFound.body}>
  <div class="flex min-h-[50vh] flex-col items-center justify-center gap-4 px-5 text-center">
    <h1 style="font-size:48px">404</h1>
    <p style="color:var(--ink-mid)">{t.notFound.body}</p>
    <a href="/" class="font-mono-label underline hover:[color:var(--accent)]">{t.notFound.back}</a>
  </div>
</BaseLayout>
